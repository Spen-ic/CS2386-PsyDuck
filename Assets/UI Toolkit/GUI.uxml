                <ui:Label text="48" display-tooltip-when-elided="true" name="line1" style="bottom: auto; -unity-font: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days.otf?fileID=12800000&amp;guid=80ca46803ba604257a835d67e0ac985a&amp;type=3#Lemon Days&quot;); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days%20SDF.asset?fileID=11400000&amp;guid=f55d18eff44df4888aae028322ae7b0a&amp;type=2#Lemon Days SDF&quot;); font-size: 65px; color: rgb(255, 205, 0); text-shadow: 3px 3px 0 rgb(0, 4, 140); margin-top: 12px; margin-right: 12px;" />
                <ui:Label text="48" display-tooltip-when-elided="true" name="line2" style="bottom: auto; -unity-font: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days.otf?fileID=12800000&amp;guid=80ca46803ba604257a835d67e0ac985a&amp;type=3#Lemon Days&quot;); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/Lemon%20Days%20SDF.asset?fileID=11400000&amp;guid=f55d18eff44df4888aae028322ae7b0a&amp;type=2#Lemon Days SDF&quot;); font-size: 65px; color: rgb(255, 205, 0); text-shadow: 3px 3px 0 rgb(0, 4, 140); margin-top: 12px; margin-right: 12px;" />
